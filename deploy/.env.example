# Copy this file to deploy/.env and fill in strong values before deploying.
# deploy/.env is gitignored so real secrets never get committed.
#
# Generate strong secrets with:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me-to-a-strong-random-value
JWT_SECRET=change-me-to-a-strong-random-value

# Optional: override the signup policy. Default "auto" opens registration only
# until the first user exists, then closes it.
# NADI_ALLOW_REGISTRATION=auto

# Optional: how many days of metric history to keep. The server's retention job
# deletes older samples hourly. Default 30.
# NADI_RETENTION_DAYS=30
